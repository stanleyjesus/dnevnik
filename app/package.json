{
  "name": "dnevnik-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Тренировочный дневник: самостоятельное офлайн-приложение",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/dev.mjs 5174 --prod",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "tokens": "node --disable-warning=ExperimentalWarning scripts/tokens.mjs",
    "parity": "node scripts/parity.mjs",
    "unit": "node --test \"tests/**/*.test.ts\"",
    "screens": "node scripts/screens.mjs",
    "offline": "node scripts/offline.mjs",
    "live": "node scripts/live.mjs",
    "sample": "node ../data/make.cjs --check",
    "check": "npm run sample && npm run typecheck && npm run tokens && npm run parity && npm run unit",
    "test": "npm run check",
    "leaks": "node scripts/leaks.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0"
  }
}
